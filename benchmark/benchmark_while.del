function fib(n : int) : int {
    let fibn_minus_2 = 0;
    let fibn_minus_1 = 1;
    let fibn = fibn_minus_1 + fibn_minus_2;
    if n == 0 {
        return fibn_minus_2;
    } else if n == 1 {
        return fibn_minus_1;
    }
    let i = 2;
    while i <= n {
        fibn = fibn_minus_1 + fibn_minus_2;
        fibn_minus_2 = fibn_minus_1;
        fibn_minus_1 = fibn;
        i++;
    }
    return fibn;
}

function main() {
    // Can only go up to 90, until we create a BigInt class
    let num_iters = 1000000;
    let x = 2;
    let i = 0;
    while i < num_iters {
        x = fib(90) - x / 2;
        i++;
    }
    println("done:", x, "!");
}
